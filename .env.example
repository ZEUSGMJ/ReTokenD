# ── Spotify ─────────────────────────────────────────────────────────────────

# Required. Default app credentials (Spotify Developer Dashboard).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Per-profile override (suffix = profile id, upper-cased, "-" → "_").
# Dashboard-entered creds take precedence.
# SPOTIFY_CLIENT_ID_PORTFOLIO=
# SPOTIFY_CLIENT_SECRET_PORTFOLIO=

# ── Auth & secrets ──────────────────────────────────────────────────────────

# Required. Bearer secret for GET /api/token.
RETOKEND_SECRET=

# Required. Gates the dashboard and auth routes.
ADMIN_PASSWORD=

# Required. Signs session/state cookies; fallback encryption key.
SESSION_SECRET=

# Optional. Dedicated key for encrypting dashboard-stored client secrets;
# falls back to SESSION_SECRET. Changing it invalidates stored secrets.
# CREDENTIALS_SECRET=

# Required. Public URL for the OAuth redirect (local dev: http://127.0.0.1:3000).
BASE_URL=

# ── Storage (pick one; REDIS_URL wins) ──────────────────────────────────────

# Self-host / Docker:
REDIS_URL=
# Upstash (Vercel Marketplace):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Misc ────────────────────────────────────────────────────────────────────

# Validates Vercel Cron requests to /api/check.
CRON_SECRET=

# Discord webhook for expiry / re-auth notifications.
DISCORD_WEBHOOK_URL=
